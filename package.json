{
  "name": "jarvis-content",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --recursive lint",
    "tsc": "pnpm --recursive tsc --noEmit",
    "test": "pnpm --recursive test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  }
}
